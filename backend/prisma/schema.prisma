generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Shared / Platform-level tables ───────────────────────────────────────────
// All models here live in the `public` schema.
// Tenant-specific tables are created per-schema via raw SQL migrations.

model Tenant {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String        @unique
  schemaName     String        @unique @map("schema_name")
  status         TenantStatus  @default(ONBOARDING)
  logoUrl        String?       @map("logo_url")
  brandPrimary   String?       @map("brand_primary")
  brandSecondary String?       @map("brand_secondary")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  features          TenantFeature[]
  users             TenantUser[]
  subscription      Subscription?
  portalPhoneIndex  PortalPhoneIndex[]

  @@map("tenants")
}

model TenantFeature {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  featureKey String    @map("feature_key")
  enabled    Boolean   @default(false)
  enabledAt  DateTime? @map("enabled_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

model TenantUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  roles        String[]
  isActive     Boolean   @default(true) @map("is_active")
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@map("tenant_users")
}

model PortalPhoneIndex {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([phone, tenantId])
  @@index([phone])
  @@map("portal_phone_index")
}

model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("platform_admins")
}

model Subscription {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String             @unique @map("tenant_id") @db.Uuid
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(ACTIVE)
  startsAt   DateTime           @map("starts_at")
  expiresAt  DateTime?          @map("expires_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])

  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum TenantStatus {
  ONBOARDING
  TRIAL
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}
